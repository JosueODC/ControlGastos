@model IEnumerable<ControlGastos.Models.Movimiento>
@{
    ViewData["Title"] = "Panel Principal";
    var saldo = (decimal)ViewBag.Saldo;
}
<div class="container my-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between
                align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Control de Gastos</h1>
            <p class="text-muted mb-0">
                Administra tus ingresos y gastos en un solo lugar.
            </p>
        </div>
        <a href="#nuevo-movimiento" class="btn btn-primary">
            + Registrar movimiento
        </a>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card box-shadow border-0 stat-card stat-income">
                <div class="card-body">
                    <p class="stat-label">Ingresos totales</p>
                    <h3 class="stat-value text-success">
                        @(((decimal)ViewBag.Ingresos).ToString("C2"))
                    </h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card box-shadow border-0 stat-card stat-expense">
                <div class="card-body">
                    <p class="stat-label">Gastos totales</p>
                    <h3 class="stat-value text-danger">
                        @(((decimal)ViewBag.Gastos).ToString("C2"))
                    </h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card box-shadow border-0 stat-card stat-balance">
                <div class="card-body">
                    <p class="stat-label">Saldo disponible</p>
                    <h3 class="stat-value @(saldo < 0 ? "text-danger" : "")">
                        @saldo.ToString("C2")
                    </h3>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-lg-8 order-2 order-lg-1">
            <div class="card box-shadow border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0 fw-semibold">Movimientos registrados</h4>
                        <span class="text-muted small">
                            @(Model?.Count() ?? 0) en total
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-movimientos table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Tipo</th>
                                    <th>Descripción</th>
                                    <th>Categoría</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var movimiento in Model)
                                    {
                                        var esIngreso = movimiento.Tipo == "Ingreso";
                                        <tr>
                                            <td class="text-nowrap">
                                                @movimiento.Fecha.ToString("dd/MM/yyyy")
                                            </td>
                                            <td>
                                                <span class="badge-tipo @(esIngreso ? "badge-ingreso" : "badge-gasto")">
                                                    @movimiento.Tipo
                                                </span>
                                            </td>
                                            <td>@movimiento.Descripcion</td>
                                            <td class="text-muted">@movimiento.Categoria</td>
                                            <td class="text-end fw-semibold text-nowrap
                                                       @(esIngreso ? "text-success" : "text-danger")">
                                                @(esIngreso ? "+" : "−")@movimiento.Cantidad.ToString("C2")
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="Home"
                                                   asp-action="Editar"
                                                   asp-route-id="@movimiento.id"
                                                   class="btn btn-sm btn-outline-primary">
                                                    Editar
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-5">
                                            Todavía no hay movimientos registrados
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 order-1 order-lg-2" id="nuevo-movimiento">
            <div class="card box-shadow border-0">
                <div class="card-body p-4">
                    <h4 class="fw-semibold mb-3">Nuevo movimiento</h4>
                    <form asp-controller="Home" asp-action="Crear" method="post">

                        <div class="mb-3">
                            <label class="form-label fw-medium d-block">Tipo de movimiento</label>
                            <div class="btn-group w-100 tipo-toggle" role="group">
                                <input type="radio" name="Tipo" value="Ingreso"
                                       id="nuevo-ingreso" class="btn-check" checked />
                                <label class="btn btn-outline-success" for="nuevo-ingreso">Ingreso</label>

                                <input type="radio" name="Tipo" value="Gasto"
                                       id="nuevo-gasto" class="btn-check" />
                                <label class="btn btn-outline-danger" for="nuevo-gasto">Gasto</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Descripción</label>
                            <input type="text" name="Descripcion" class="form-control"
                                   placeholder="Ej. Pago de transporte" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Cantidad</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" name="Cantidad" class="form-control"
                                       placeholder="250.00" min="0.01" step="0.01" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Categoría</label>
                            <select name="Categoria" class="form-select" required>
                                <option value="Alimentación">Alimentación</option>
                                <option value="Transporte">Transporte</option>
                                <option value="Escuela">Escuela</option>
                                <option value="Salud">Salud</option>
                                <option value="Otros">Otros</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium">Fecha</label>
                            <input type="date" name="Fecha" class="form-control"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            Guardar movimiento
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>